<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:id="@+id/button_dirsOtherSet_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="선택" />

    <Button
        android:id="@+id/button_dirsOtherSet_viewSet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="보기 방식" />

    <Button
        android:id="@+id/button_dirsOtherSet_sortSet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="정렬 방식" />

    <Button
        android:id="@+id/button_dirsOtherSet_addFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="폴더 추가" />
=
</LinearLayout>