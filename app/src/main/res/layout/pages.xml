<?xml version="1.0" encoding="utf-8"?>
<com.example.stampit2.Note.PagesView.PagesView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linearLayout_pages_top"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal">


        <Button
            android:id="@+id/button_pages_exit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="B"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/textView_pages_pageInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:gravity="center_vertical|start"
            android:text="1/4" />

        <Button
            android:id="@+id/button_pages_selectPages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="C"
            android:textSize="8sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_pages"
        android:layout_width="match_parent"
        android:layout_height="658dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/linearLayout_pages_bottom"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_pages_deletePages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete" />
    </LinearLayout>
</com.example.stampit2.Note.PagesView.PagesView>